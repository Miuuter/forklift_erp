# Image imported into Synology Container Manager or pulled from a registry.
ERP_IMAGE=forklift-erp
ERP_VERSION=0.2.0-rc.1
ERP_HTTP_PORT=8080
TZ=Asia/Shanghai

# Conservative defaults for a small NAS. Increase only after measuring.
ERP_APP_MEMORY_LIMIT=1536m
ERP_MYSQL_MEMORY_LIMIT=768m
ERP_MYSQL_BUFFER_POOL_SIZE=256M
ERP_MYSQL_LOG_BUFFER_SIZE=8M
ERP_MYSQL_KEY_BUFFER_SIZE=1M
ERP_MYSQL_MAX_CONNECTIONS=50
ERP_MYSQL_TABLE_OPEN_CACHE=1000
ERP_MYSQL_PS_DIGESTS_SIZE=1000
ERP_MYSQL_PS_STATEMENT_HISTORY_LONG_SIZE=1000
ERP_DB_POOL_MAX_SIZE=12
ERP_DB_POOL_MIN_IDLE=2
ERP_HTTP_MAX_THREADS=64
ERP_HTTP_MIN_SPARE_THREADS=8
ERP_JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=60.0 -XX:InitialRAMPercentage=10.0 -XX:+ExitOnOutOfMemoryError"
ERP_SHUTDOWN_TIMEOUT=45s

# Replace every example secret before the first start.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
ERP_DB_PASSWORD=replace-with-a-long-random-database-password
ERP_JWT_SECRET=replace-with-at-least-32-bytes-of-random-text
ERP_JWT_EXPIRATION=86400000
ERP_IMPORT_RETENTION_DAYS=30
# Put this on a separate volume, NAS, or mounted remote share.
ERP_BACKUP_DIR=/volume1/docker/forklift-erp/backup
ERP_BACKUP_REMOTE_DIR=/volume2/forklift-erp-backup
# The backup briefly stops the app so the SQL dump and uploads archive share
# one quiescent point. Increase only for unusually slow shutdowns/startups.
ERP_BACKUP_APP_STOP_TIMEOUT=60
ERP_BACKUP_DB_DRAIN_ATTEMPTS=60
ERP_BACKUP_HEALTH_ATTEMPTS=60
ERP_BACKUP_HEALTH_INTERVAL=2
ERP_ALLOW_LEGACY_BACKUP=false
ERP_RESTORE_MYSQL_IMAGE=mysql:8.0.43
ERP_RESTORE_EXPECTED_FLYWAY_VERSION=51
ERP_ADMIN_USERNAME=admin
ERP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
